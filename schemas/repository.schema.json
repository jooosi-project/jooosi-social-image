{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jooosi.com/social-image/schemas/repository.schema.json",
  "title": "Social Image preset repository",
  "description": "A versioned repository of reusable Social Image image-design presets.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "title", "description", "presets"],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "homepage": { "type": "string", "format": "uri", "maxLength": 2048 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "presets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "preset.schema.json" }
    }
  }
}
